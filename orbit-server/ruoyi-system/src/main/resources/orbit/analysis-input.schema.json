{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "CAMPAIGN",
        "ADSET",
        "AD"
      ]
    },
    "metric_profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "current": {
      "$ref": "#/$defs/MetricValues"
    },
    "previous": {
      "$ref": "#/$defs/MetricValues"
    },
    "daily_points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "business_date": {
            "type": "string",
            "format": "date"
          },
          "values": {
            "$ref": "#/$defs/MetricValues"
          }
        },
        "required": [
          "business_date",
          "values"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 28
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "entity_id": {
            "type": "string",
            "format": "uuid"
          },
          "metric": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "date_from": {
            "type": "string",
            "format": "date"
          },
          "date_to": {
            "type": "string",
            "format": "date"
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
                "maxLength": 28
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "calculation_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "id",
          "entity_id",
          "metric",
          "date_from",
          "date_to",
          "value",
          "unit",
          "calculation_version"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 500
    },
    "budget_owner_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget_before": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
          "maxLength": 28
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
      "maxLength": 28
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "entity_age_hours": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
      "maxLength": 28
    },
    "paused_hours": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
      "maxLength": 28
    },
    "maturity_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "quality": {
      "type": "string",
      "enum": [
        "SUFFICIENT",
        "INSUFFICIENT",
        "STALE",
        "PARTIAL"
      ]
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "snapshot_id",
    "entity_id",
    "entity_type",
    "metric_profile_id",
    "policy_version",
    "currency",
    "current",
    "previous",
    "daily_points",
    "evidence",
    "budget_owner_id",
    "budget_before",
    "coverage",
    "observed_at",
    "entity_age_hours",
    "paused_hours",
    "maturity_days",
    "quality"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "MetricValues": {
      "type": "object",
      "properties": {
        "spend": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
              "maxLength": 28
            },
            {
              "type": "null"
            }
          ]
        },
        "impressions": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
              "maxLength": 28
            },
            {
              "type": "null"
            }
          ]
        },
        "clicks": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
              "maxLength": 28
            },
            {
              "type": "null"
            }
          ]
        },
        "registrations": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
              "maxLength": 28
            },
            {
              "type": "null"
            }
          ]
        },
        "purchases": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
              "maxLength": 28
            },
            {
              "type": "null"
            }
          ]
        },
        "purchase_value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
              "maxLength": 28
            },
            {
              "type": "null"
            }
          ]
        },
        "roas": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
              "maxLength": 28
            },
            {
              "type": "null"
            }
          ]
        },
        "cpm": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
              "maxLength": 28
            },
            {
              "type": "null"
            }
          ]
        },
        "ctr": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
              "maxLength": 28
            },
            {
              "type": "null"
            }
          ]
        },
        "cpc": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
              "maxLength": 28
            },
            {
              "type": "null"
            }
          ]
        },
        "cpa": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
              "maxLength": 28
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$",
              "maxLength": 28
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "spend",
        "impressions",
        "clicks",
        "registrations",
        "purchases",
        "purchase_value",
        "roas",
        "cpm",
        "ctr",
        "cpc",
        "cpa",
        "usage"
      ],
      "additionalProperties": false
    }
  }
}
