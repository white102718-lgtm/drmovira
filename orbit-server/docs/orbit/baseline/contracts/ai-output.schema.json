{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisRecommendationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action",
    "target_entity_id",
    "budget_owner_id",
    "before",
    "after",
    "currency",
    "reason",
    "evidence_ids",
    "risks",
    "data_quality",
    "policy_version",
    "model_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "action": {
      "enum": [
        "OBSERVE",
        "BUDGET_SET",
        "PAUSE",
        "DELETE"
      ]
    },
    "target_entity_id": {
      "type": "string",
      "format": "uuid"
    },
    "budget_owner_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "before": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"
    },
    "after": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "reason": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "data_quality": {
      "enum": [
        "SUFFICIENT",
        "INSUFFICIENT",
        "STALE",
        "PARTIAL"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "BUDGET_SET"
          }
        }
      },
      "then": {
        "properties": {
          "after": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "budget_owner_id": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "after": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_quality": {
            "enum": [
              "INSUFFICIENT",
              "STALE",
              "PARTIAL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "action": {
            "const": "OBSERVE"
          }
        }
      }
    }
  ],
  "description": "Server must additionally check evidence membership, ownership, amount positivity and policy limits; model_version is stamped/verified by adapter, not trusted from model."
}