server {
    server_name adpulse.biz a-d-loop.com yoyoad.org;
    client_max_body_size 500M;  # 根据需要调整大小

    # 工单素材上传（大文件最大 10G）：外层域名入口也要放开包体/超时并关闭缓冲，否则请求先卡在这层的 500M
    location = /backend/material-orders/attachments {
        client_max_body_size 10g;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_pass http://127.0.0.1:5555;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:5555;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /af_port/ {
        proxy_pass http://172.31.37.225:8961/appsflyer/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /callback/ {
        proxy_pass http://172.31.37.225:8961/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # MinIO 图片代理（新增）
    location /minio/ {
        proxy_pass http://18.139.123.178:9000/;
        # 关键：保留原始 MinIO 的 Host，确保签名验证通过
        proxy_set_header Host 18.139.123.178:9000;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 支持大文件
        client_max_body_size 100M;
        proxy_buffering off;

        # 超时设置
        proxy_connect_timeout 60;
        proxy_send_timeout 60;
        proxy_read_timeout 60;
    }

    listen 443 ssl http2; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/adpulse.biz/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/adpulse.biz/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = a-d-loop.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = adpulse.biz) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = yoyoad.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name adpulse.biz a-d-loop.com yoyoad.org;
    return 301 https://$host$request_uri;

}
